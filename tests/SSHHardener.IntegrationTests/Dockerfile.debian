ARG IMAGE=debian:12
FROM ${IMAGE}
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends openssh-server sudo ca-certificates && rm -rf /var/lib/apt/lists/*
COPY prepare.sh /prepare.sh
RUN /bin/sh /prepare.sh
COPY entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/bin/sh", "/entrypoint.sh"]
